+++ b/tests/test_fd_macos.rs
@@ -0,0 +1,213 @@
+//! Authored native qualification cases for the descriptor snapshot proposal.
+//! These have not been executed as part of the Optiflow checkpoint.
+#![cfg(all(target_os = "macos", target_pointer_width = "64"))]
+
+use exacl::fd_macos::{Ace, AceKind, AclSnapshot, Limits, read_fd, replace_fd};
+use exacl::{AclEntry, Flag, Perm, setfacl};
+use std::fs::{self, File, Metadata, OpenOptions, Permissions};
+use std::io::{self, Write};
+use std::os::fd::AsFd;
+use std::os::unix::fs::{FileExt, MetadataExt, PermissionsExt};
+use std::path::Path;
+use std::time::{Duration, UNIX_EPOCH};
+
+const CONTENT: &[u8] = b"synthetic ACL qualification bytes\0\xff";
+
+fn set_owner_acl(path: &Path, file: &File, permissions: Perm, flags: Flag) -> io::Result<()> {
+    // Resolve this fixture's real owner through the existing API. These tests
+    // exercise preservation, not the permission effect of an arbitrary UUID.
+    let owner = file.metadata()?.uid().to_string();
+    setfacl(&[path], &[AclEntry::allow_user(&owner, permissions, flags)], None)
+}
+
+fn prepare_content(file: &mut File) -> io::Result<Metadata> {
+    file.write_all(CONTENT)?;
+    file.set_permissions(Permissions::from_mode(0o640))?;
+    file.set_modified(UNIX_EPOCH + Duration::new(1_600_000_000, 123_456_789))?;
+    file.metadata()
+}
+
+fn assert_file_properties_unchanged(file: &File, before: &Metadata) -> io::Result<()> {
+    let after = file.metadata()?;
+    assert_eq!(after.dev(), before.dev());
+    assert_eq!(after.ino(), before.ino());
+    assert_eq!(after.nlink(), before.nlink());
+    assert_eq!(after.uid(), before.uid());
+    assert_eq!(after.gid(), before.gid());
+    assert_eq!(after.mode(), before.mode());
+    assert_eq!(after.len(), before.len());
+    assert_eq!(after.mtime(), before.mtime());
+    assert_eq!(after.mtime_nsec(), before.mtime_nsec());
+    let mut actual = vec![0; CONTENT.len()];
+    file.read_exact_at(&mut actual, 0)?;
+    assert_eq!(actual.as_slice(), CONTENT);
+    // ACL updates may change ctime, and reading content may change atime.
+    Ok(())
+}
+
+fn inherited_child() -> io::Result<(tempfile::TempDir, File, File)> {
+    let directory = tempfile::tempdir()?;
+    let parent_path = directory.path().join("inheriting-parent");
+    fs::create_dir(&parent_path)?;
+    let parent = File::open(&parent_path)?;
+    set_owner_acl(
+        &parent_path,
+        &parent,
+        Perm::WRITE,
+        Flag::FILE_INHERIT | Flag::ONLY_INHERIT,
+    )?;
+    let child = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create_new(true)
+        .open(parent_path.join("child"))?;
+    let parent_acl = read_fd(parent.as_fd(), Limits::default())?;
+    let AclSnapshot::Present { entries: parent_entries, .. } = &parent_acl else {
+        panic!("fixture parent must have an inheritable ACL");
+    };
+    assert_eq!(parent_entries.len(), 1);
+    let child_acl = read_fd(child.as_fd(), Limits::default())?;
+    let AclSnapshot::Present { entries, .. } = &child_acl else {
+        panic!("new child must actually inherit its parent ACL");
+    };
+    assert!(entries.iter().any(|entry| {
+        entry.principal == parent_entries[0].principal
+            && entry.kind == AceKind::Allow
+            && entry.permissions == Perm::WRITE.bits()
+            && entry.flags & Flag::INHERITED.bits() != 0
+    }));
+    // Do not assume an exact rewrite of the parent's other inheritance flags.
+    Ok((directory, parent, child))
+}
+
+fn snapshot() -> AclSnapshot {
+    // Raw UUIDs intentionally need not resolve through Directory Services.
+    AclSnapshot::Present {
+        flags: 0x0002_0000,
+        entries: vec![
+            Ace { principal: [0x55; 16], kind: AceKind::Deny, flags: 0, permissions: 4 },
+            Ace { principal: [0xaa; 16], kind: AceKind::Allow, flags: 0, permissions: 2 },
+            Ace { principal: [0x55; 16], kind: AceKind::Deny, flags: 0, permissions: 4 },
+        ],
+    }
+}
+
+#[test]
+fn native_preserves_order_duplicates_uuid_and_acl_flags() -> io::Result<()> {
+    let file = tempfile::tempfile()?;
+    let expected = snapshot();
+    assert_eq!(replace_fd(file.as_fd(), &expected, Limits::default())?, expected);
+    assert_eq!(read_fd(file.as_fd(), Limits::default())?, expected);
+    Ok(())
+}
+
+#[test]
+fn native_distinguishes_absent_from_present_empty() -> io::Result<()> {
+    let file = tempfile::tempfile()?;
+    let limits = Limits { maximum_entries: 0 };
+    let present = AclSnapshot::Present { flags: 0, entries: vec![] };
+    assert_eq!(replace_fd(file.as_fd(), &present, limits)?, present);
+    assert_eq!(replace_fd(file.as_fd(), &AclSnapshot::Absent, limits)?, AclSnapshot::Absent);
+    assert_eq!(read_fd(file.as_fd(), limits)?, AclSnapshot::Absent);
+    Ok(())
+}
+
+#[test]
+fn native_descriptor_survives_rename_and_path_replacement() -> io::Result<()> {
+    let directory = tempfile::tempdir()?;
+    let path = directory.path().join("source");
+    let moved = directory.path().join("held");
+    let original = File::create(&path)?;
+    fs::rename(&path, &moved)?;
+    let replacement = File::create(&path)?;
+    let replacement_before = read_fd(replacement.as_fd(), Limits::default())?;
+    let expected = snapshot();
+    replace_fd(original.as_fd(), &expected, Limits::default())?;
+    assert_eq!(read_fd(original.as_fd(), Limits::default())?, expected);
+    assert_eq!(read_fd(File::open(&moved)?.as_fd(), Limits::default())?, expected);
+    assert_eq!(read_fd(replacement.as_fd(), Limits::default())?, replacement_before);
+    Ok(())
+}
+
+#[test]
+fn native_invalid_snapshot_and_bounds_do_not_change_acl() -> io::Result<()> {
+    let file = tempfile::tempfile()?;
+    let expected = snapshot();
+    replace_fd(file.as_fd(), &expected, Limits::default())?;
+    assert!(read_fd(file.as_fd(), Limits { maximum_entries: 2 }).is_err());
+    let invalid = AclSnapshot::Present { flags: u32::MAX, entries: vec![] };
+    assert!(replace_fd(file.as_fd(), &invalid, Limits::default()).is_err());
+    assert!(replace_fd(file.as_fd(), &AclSnapshot::Absent, Limits { maximum_entries: 129 }).is_err());
+    assert_eq!(read_fd(file.as_fd(), Limits::default())?, expected);
+    Ok(())
+}
+
+#[test]
+fn native_non_filesystem_descriptor_errors_are_not_absence() -> io::Result<()> {
+    let (socket, _peer) = std::os::unix::net::UnixStream::pair()?;
+    assert!(read_fd(socket.as_fd(), Limits::default()).is_err());
+    Ok(())
+}
+
+#[test]
+fn native_acl_install_and_removal_preserve_file_properties() -> io::Result<()> {
+    let source = tempfile::NamedTempFile::new()?;
+    set_owner_acl(source.path(), source.as_file(), Perm::READ, Flag::empty())?;
+    let expected = read_fd(source.as_file().as_fd(), Limits::default())?;
+    assert!(matches!(&expected, AclSnapshot::Present { entries, .. } if entries.len() == 1));
+
+    let mut target = tempfile::tempfile()?;
+    replace_fd(target.as_fd(), &AclSnapshot::Absent, Limits::default())?;
+    let before = prepare_content(&mut target)?;
+    assert_eq!(replace_fd(target.as_fd(), &expected, Limits::default())?, expected);
+    assert_file_properties_unchanged(&target, &before)?;
+    assert_eq!(read_fd(target.as_fd(), Limits::default())?, expected);
+
+    assert_eq!(
+        replace_fd(target.as_fd(), &AclSnapshot::Absent, Limits::default())?,
+        AclSnapshot::Absent,
+    );
+    assert_file_properties_unchanged(&target, &before)?;
+    assert_eq!(read_fd(target.as_fd(), Limits::default())?, AclSnapshot::Absent);
+    Ok(())
+}
+
+#[test]
+fn native_source_acl_replaces_inherited_destination_entries_exactly() -> io::Result<()> {
+    let source = tempfile::NamedTempFile::new()?;
+    set_owner_acl(source.path(), source.as_file(), Perm::READ, Flag::empty())?;
+    let expected = read_fd(source.as_file().as_fd(), Limits::default())?;
+    let (_directory, parent, mut destination) = inherited_child()?;
+    let inherited = read_fd(destination.as_fd(), Limits::default())?;
+    assert_ne!(inherited, expected);
+    let parent_before = read_fd(parent.as_fd(), Limits::default())?;
+    let before = prepare_content(&mut destination)?;
+    assert_eq!(read_fd(destination.as_fd(), Limits::default())?, inherited);
+
+    assert_eq!(replace_fd(destination.as_fd(), &expected, Limits::default())?, expected);
+    assert_eq!(read_fd(destination.as_fd(), Limits::default())?, expected);
+    assert_file_properties_unchanged(&destination, &before)?;
+    assert_eq!(read_fd(parent.as_fd(), Limits::default())?, parent_before);
+    assert_eq!(read_fd(source.as_file().as_fd(), Limits::default())?, expected);
+    Ok(())
+}
+
+#[test]
+fn native_absent_source_acl_removes_inherited_destination_entries() -> io::Result<()> {
+    let source = tempfile::tempfile()?;
+    replace_fd(source.as_fd(), &AclSnapshot::Absent, Limits::default())?;
+    let expected = read_fd(source.as_fd(), Limits::default())?;
+    assert_eq!(expected, AclSnapshot::Absent);
+    let (_directory, parent, mut destination) = inherited_child()?;
+    let inherited = read_fd(destination.as_fd(), Limits::default())?;
+    let parent_before = read_fd(parent.as_fd(), Limits::default())?;
+    let before = prepare_content(&mut destination)?;
+    assert_eq!(read_fd(destination.as_fd(), Limits::default())?, inherited);
+
+    assert_eq!(replace_fd(destination.as_fd(), &expected, Limits::default())?, expected);
+    assert_eq!(read_fd(destination.as_fd(), Limits::default())?, AclSnapshot::Absent);
+    assert_file_properties_unchanged(&destination, &before)?;
+    assert_eq!(read_fd(parent.as_fd(), Limits::default())?, parent_before);
+    assert_eq!(read_fd(source.as_fd(), Limits::default())?, AclSnapshot::Absent);
+    Ok(())
+}
