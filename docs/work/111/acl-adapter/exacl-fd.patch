@@ -0,0 +1,77 @@
+//! Authored native qualification cases for the descriptor snapshot proposal.
+//! These have not been executed as part of the Optiflow checkpoint.
+#![cfg(all(target_os = "macos", target_pointer_width = "64"))]
+
+use exacl::fd_macos::{Ace, AceKind, AclSnapshot, Limits, read_fd, replace_fd};
+use std::fs::{self, File};
+use std::io;
+use std::os::fd::AsFd;
+
+fn snapshot() -> AclSnapshot {
+    // Raw UUIDs intentionally need not resolve through Directory Services.
+    AclSnapshot::Present {
+        flags: 0x0002_0000,
+        entries: vec![
+            Ace { principal: [0x55; 16], kind: AceKind::Deny, flags: 0, permissions: 4 },
+            Ace { principal: [0xaa; 16], kind: AceKind::Allow, flags: 0, permissions: 2 },
+            Ace { principal: [0x55; 16], kind: AceKind::Deny, flags: 0, permissions: 4 },
+        ],
+    }
+}
+
+#[test]
+fn native_preserves_order_duplicates_uuid_and_acl_flags() -> io::Result<()> {
+    let file = tempfile::tempfile()?;
+    let expected = snapshot();
+    assert_eq!(replace_fd(file.as_fd(), &expected, Limits::default())?, expected);
+    assert_eq!(read_fd(file.as_fd(), Limits::default())?, expected);
+    Ok(())
+}
+
+#[test]
+fn native_distinguishes_absent_from_present_empty() -> io::Result<()> {
+    let file = tempfile::tempfile()?;
+    let limits = Limits { maximum_entries: 0 };
+    let present = AclSnapshot::Present { flags: 0, entries: vec![] };
+    assert_eq!(replace_fd(file.as_fd(), &present, limits)?, present);
+    assert_eq!(replace_fd(file.as_fd(), &AclSnapshot::Absent, limits)?, AclSnapshot::Absent);
+    assert_eq!(read_fd(file.as_fd(), limits)?, AclSnapshot::Absent);
+    Ok(())
+}
+
+#[test]
+fn native_descriptor_survives_rename_and_path_replacement() -> io::Result<()> {
+    let directory = tempfile::tempdir()?;
+    let path = directory.path().join("source");
+    let moved = directory.path().join("held");
+    let original = File::create(&path)?;
+    fs::rename(&path, &moved)?;
+    let replacement = File::create(&path)?;
+    let replacement_before = read_fd(replacement.as_fd(), Limits::default())?;
+    let expected = snapshot();
+    replace_fd(original.as_fd(), &expected, Limits::default())?;
+    assert_eq!(read_fd(original.as_fd(), Limits::default())?, expected);
+    assert_eq!(read_fd(File::open(&moved)?.as_fd(), Limits::default())?, expected);
+    assert_eq!(read_fd(replacement.as_fd(), Limits::default())?, replacement_before);
+    Ok(())
+}
+
+#[test]
+fn native_invalid_snapshot_and_bounds_do_not_change_acl() -> io::Result<()> {
+    let file = tempfile::tempfile()?;
+    let expected = snapshot();
+    replace_fd(file.as_fd(), &expected, Limits::default())?;
+    assert!(read_fd(file.as_fd(), Limits { maximum_entries: 2 }).is_err());
+    let invalid = AclSnapshot::Present { flags: u32::MAX, entries: vec![] };
+    assert!(replace_fd(file.as_fd(), &invalid, Limits::default()).is_err());
+    assert!(replace_fd(file.as_fd(), &AclSnapshot::Absent, Limits { maximum_entries: 129 }).is_err());
+    assert_eq!(read_fd(file.as_fd(), Limits::default())?, expected);
+    Ok(())
+}
+
+#[test]
+fn native_non_filesystem_descriptor_errors_are_not_absence() -> io::Result<()> {
+    let (socket, _peer) = std::os::unix::net::UnixStream::pair()?;
+    assert!(read_fd(socket.as_fd(), Limits::default()).is_err());
+    Ok(())
+}
