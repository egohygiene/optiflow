@@ -0,0 +1,436 @@
+//! Descriptor-only ACL evidence for 64-bit macOS.
+//!
+//! This API does not use the name-resolving [`crate::AclEntry`] representation.
+//! It preserves entry order, raw principal UUIDs, ACL flags and entry bits. It
+//! distinguishes an absent ACL from a present ACL containing zero entries.
+//! Unknown public bits are refused rather than silently discarded. Private
+//! low 16 ACL flag bits are preserved, as required by Darwin's `kauth.h`.
+//!
+//! Every read checks the volume's valid extended-security capability before
+//! and after a strict descriptor query. Missing capability, failed calls and
+//! malformed/truncated replies are errors, never evidence of an absent ACL.
+//! Memory and decoded entry counts are bounded; kernel call latency is not.
+//! A descriptor pins an object, not its metadata against concurrent mutation.
+//! Callers must retain their own object/metadata checks around copy operations.
+//! This is the kernel-exposed ACL state, not an independent inspection of
+//! on-disk metadata: the kernel may normalize some malformed security data.
+//! Deferred-inheritance flags can change ACLs on rename; consumers must reread
+//! after namespace changes instead of treating this snapshot as future proof.
+//!
+//! This proposed API uses public `fgetattrlist`/`fsetattrlist` interfaces with
+//! fixed buffers, avoiding `acl_get_fd_np`'s internal allocating retry loop.
+//! ABI and absence semantics are based on Apple Libc commit
+//! `71bbe350ab79eef58113991d817ccc6165061a64` and XNU commit
+//! `f6217f891ac0bb64f3d375211650a4c1ff8ca1ea`. Native qualification is required
+//! before adopting this proposal in a destructive copy transaction.
+
+use std::ffi::{c_int, c_uint, c_void};
+use std::io;
+use std::os::fd::{AsRawFd, BorrowedFd};
+
+const MAX_ENTRIES: usize = 128;
+const FILESEC_HEADER: usize = 44;
+const ACE_BYTES: usize = 24;
+const SECURITY_REPLY_HEADER: usize = 12;
+const FILESEC_MAGIC: u32 = 0x012c_c16d;
+const NO_ACL: u32 = u32::MAX;
+const ACL_FLAGS: u32 = 0x0003_ffff; // private low16, defer-inherit, no-inherit
+const ACE_FLAGS: u32 = 0x0000_01f0;
+const ACE_PERMISSIONS: u32 = 0x01f0_3ffe; // explicit rights plus generic bits21..24
+const EXTENDED_SECURITY: u32 = 0x0040_0000;
+const VOL_INFO: u32 = 0x8000_0000;
+const VOL_CAPABILITIES: u32 = 0x0002_0000;
+const VOL_EXTENDED_SECURITY: u32 = 0x0000_0400;
+const REPORT_FULL_SIZE: c_uint = 0x0000_0004;
+
+/// Caller-selected decoding bound, capped by Darwin's 128-entry profile.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Limits {
+    /// Maximum ACE count, from zero through 128. Zero permits absent/empty ACLs.
+    pub maximum_entries: usize,
+}
+
+impl Default for Limits {
+    fn default() -> Self {
+        Self { maximum_entries: MAX_ENTRIES }
+    }
+}
+
+impl Limits {
+    fn validate(self) -> io::Result<()> {
+        if self.maximum_entries > MAX_ENTRIES {
+            return Err(io::Error::new(io::ErrorKind::InvalidInput, "ACL entry limit exceeds 128"));
+        }
+        Ok(())
+    }
+}
+
+/// Darwin's supported ordered ACE kinds.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum AceKind {
+    /// Permit the specified rights.
+    Allow,
+    /// Deny the specified rights.
+    Deny,
+}
+
+/// An ACE with no principal-name lookup or canonical reordering.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Ace {
+    /// Exact 16-byte Darwin principal UUID; it need not resolve locally.
+    pub principal: [u8; 16],
+    /// Allow or deny; audit/alarm/unknown kinds are outside this profile.
+    pub kind: AceKind,
+    /// Raw inheritance flags, excluding the ACE kind nibble.
+    pub flags: u32,
+    /// Raw supported Darwin rights mask.
+    pub permissions: u32,
+}
+
+/// Kernel-exposed ACL state, distinct from failed or unavailable observation.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum AclSnapshot {
+    /// Extended security is supported and the object has no ACL.
+    Absent,
+    /// An ACL exists; zero entries are deliberately distinct from `Absent`.
+    Present {
+        /// Raw ACL flags, including private low 16 bits without interpretation.
+        flags: u32,
+        /// ACEs in exact native order; duplicates remain significant.
+        entries: Vec<Ace>,
+    },
+}
+
+/// Read a bounded, lossless ACL snapshot from an already-open object.
+///
+/// No path is opened, no principal is resolved, and no ACL is changed. Three
+/// bounded native calls are made: capability, ACL, capability. This is not a
+/// lock or an atomic assertion about concurrent mount/metadata changes.
+///
+/// # Errors
+/// Unsupported capability, unknown bits, decoding limits, malformed responses
+/// and native errors are returned without converting them to `Absent`.
+pub fn read_fd(fd: BorrowedFd<'_>, limits: Limits) -> io::Result<AclSnapshot> {
+    limits.validate()?;
+    require_extended_security(fd)?;
+    let mut request = AttrList::new(EXTENDED_SECURITY, 0);
+    let mut buffer = vec![0; SECURITY_REPLY_HEADER + FILESEC_HEADER + limits.maximum_entries * ACE_BYTES];
+    get_attributes(fd, &mut request, &mut buffer)?;
+    let snapshot = decode_security_reply(&buffer, limits)?;
+    require_extended_security(fd)?;
+    Ok(snapshot)
+}
+
+/// Replace an object's ACL through its descriptor and reread the exact result.
+///
+/// The caller must separately authorize this metadata mutation. The write is
+/// not a transaction, does not synchronize storage, and does not alter data,
+/// ownership, timestamps or mode by request. Native side effects such as ctime
+/// updates remain possible. **An error does not imply rollback:** a successful
+/// native write followed by a failed/mismatching reread returns an error while
+/// the ACL may already have changed. No source deletion is performed.
+///
+/// # Errors
+/// Invalid/unsupported snapshots are rejected before the setter. Native errors
+/// and fresh observations unequal to `snapshot` are propagated as errors.
+pub fn replace_fd(
+    fd: BorrowedFd<'_>,
+    snapshot: &AclSnapshot,
+    limits: Limits,
+) -> io::Result<AclSnapshot> {
+    limits.validate()?;
+    let payload = encode_filesec(snapshot, limits)?;
+    // Establish that the target can be observed before requesting a change.
+    read_fd(fd, limits)?;
+    let mut buffer = Vec::with_capacity(8 + payload.len());
+    buffer.extend_from_slice(&8_i32.to_ne_bytes());
+    buffer.extend_from_slice(&(payload.len() as u32).to_ne_bytes());
+    buffer.extend_from_slice(&payload);
+    let mut request = AttrList::new(EXTENDED_SECURITY, 0);
+    // SAFETY: fd remains borrowed for this call; request has the public C ABI
+    // layout; buffer is initialized, writable and lives for its exact length.
+    // Only EXTENDED_SECURITY is selected, and its relative reference stays
+    // wholly inside buffer. LP64 Darwin declares options as unsigned int.
+    let result = unsafe {
+        fsetattrlist(fd.as_raw_fd(), (&raw mut request).cast(), buffer.as_mut_ptr().cast(), buffer.len(), 0)
+    };
+    if result != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let observed = read_fd(fd, limits)?;
+    if &observed != snapshot {
+        return Err(invalid("ACL changed or was normalized during descriptor replacement; write may have occurred"));
+    }
+    Ok(observed)
+}
+
+#[repr(C)]
+struct AttrList {
+    bitmapcount: u16,
+    reserved: u16,
+    commonattr: u32,
+    volattr: u32,
+    dirattr: u32,
+    fileattr: u32,
+    forkattr: u32,
+}
+
+impl AttrList {
+    fn new(commonattr: u32, volattr: u32) -> Self {
+        Self { bitmapcount: 5, reserved: 0, commonattr, volattr, dirattr: 0, fileattr: 0, forkattr: 0 }
+    }
+}
+
+// Apple Libc include/unistd.h LP64 declarations. These interfaces copy bounded
+// caller buffers; unlike acl_get_fd_np they allocate no caller-owned C objects.
+unsafe extern "C" {
+    fn fgetattrlist(fd: c_int, attributes: *mut c_void, buffer: *mut c_void, size: usize, options: c_uint) -> c_int;
+    fn fsetattrlist(fd: c_int, attributes: *mut c_void, buffer: *mut c_void, size: usize, options: c_uint) -> c_int;
+}
+
+fn get_attributes(fd: BorrowedFd<'_>, request: &mut AttrList, buffer: &mut [u8]) -> io::Result<()> {
+    // SAFETY: the borrowed fd cannot be closed by safe Rust during this call;
+    // AttrList matches the public LP64 ABI, and buffer is writable for exactly
+    // buffer.len() bytes. No pointer is retained by fgetattrlist. REPORT_FULLSIZE
+    // exposes truncation rather than letting a short copied prefix look whole.
+    let result = unsafe {
+        fgetattrlist(fd.as_raw_fd(), (request as *mut AttrList).cast(), buffer.as_mut_ptr().cast(), buffer.len(), REPORT_FULL_SIZE)
+    };
+    if result != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(())
+}
+
+fn require_extended_security(fd: BorrowedFd<'_>) -> io::Result<()> {
+    let mut request = AttrList::new(0, VOL_INFO | VOL_CAPABILITIES);
+    let mut buffer = [0; 36]; // length + capabilities[4] + valid[4]
+    get_attributes(fd, &mut request, &mut buffer)?;
+    decode_capability_reply(&buffer)
+}
+
+fn decode_capability_reply(buffer: &[u8]) -> io::Result<()> {
+    if buffer.len() != 36 || word(buffer, 0)? != 36 {
+        return Err(invalid("invalid or truncated volume capability reply"));
+    }
+    // VOL_CAPABILITIES_INTERFACES is index 1 in each four-word array.
+    if word(buffer, 8)? & VOL_EXTENDED_SECURITY == 0
+        || word(buffer, 24)? & VOL_EXTENDED_SECURITY == 0
+    {
+        return Err(io::Error::new(io::ErrorKind::Unsupported, "volume extended-security capability is not valid and supported"));
+    }
+    Ok(())
+}
+
+fn decode_security_reply(buffer: &[u8], limits: Limits) -> io::Result<AclSnapshot> {
+    let length = word(buffer, 0)? as usize;
+    if length < SECURITY_REPLY_HEADER || length > buffer.len() {
+        return Err(invalid("invalid or truncated ACL reply"));
+    }
+    let offset = word(buffer, 4)? as i32;
+    let size = word(buffer, 8)? as usize;
+    if offset != 8 || SECURITY_REPLY_HEADER.checked_add(size) != Some(length) {
+        return Err(invalid("invalid ACL relative reference"));
+    }
+    if size == 0 {
+        // Only reached after successful strict (non RETURNED_ATTRS/PACK_INVAL)
+        // query on an observed extended-security-capable volume. XNU returns
+        // EINVAL for unsupported active attrs; supported null va_acl packs 0.
+        return Ok(AclSnapshot::Absent);
+    }
+    decode_filesec(&buffer[SECURITY_REPLY_HEADER..length], limits)
+}
+
+fn decode_filesec(bytes: &[u8], limits: Limits) -> io::Result<AclSnapshot> {
+    if bytes.len() < FILESEC_HEADER || word(bytes, 0)? != FILESEC_MAGIC {
+        return Err(invalid("invalid ACL security header"));
+    }
+    // EXTENDED_SECURITY returns only ACL data; owner/group UUID slots must be
+    // null. A future changed layout must not silently discard extra identity.
+    if bytes[4..36].iter().any(|byte| *byte != 0) {
+        return Err(invalid("unexpected ownership UUIDs in ACL-only reply"));
+    }
+    let count = word(bytes, 36)?;
+    let flags = word(bytes, 40)?;
+    if count == NO_ACL {
+        if bytes.len() != FILESEC_HEADER || flags != 0 {
+            return Err(invalid("invalid absent-ACL security header"));
+        }
+        return Ok(AclSnapshot::Absent);
+    }
+    let count = count as usize;
+    if count > limits.maximum_entries || count > MAX_ENTRIES
+        || bytes.len() != FILESEC_HEADER + count * ACE_BYTES
+        || flags & !ACL_FLAGS != 0
+    {
+        return Err(invalid("unsupported ACL flags, entry count or payload size"));
+    }
+    let mut entries = Vec::with_capacity(count);
+    for entry in bytes[FILESEC_HEADER..].chunks_exact(ACE_BYTES) {
+        let mut principal = [0; 16];
+        principal.copy_from_slice(&entry[..16]);
+        let kind_and_flags = word(entry, 16)?;
+        let kind = match kind_and_flags & 0xf {
+            1 => AceKind::Allow,
+            2 => AceKind::Deny,
+            _ => return Err(invalid("unsupported ACL entry kind")),
+        };
+        let flags = kind_and_flags & !0xf;
+        let permissions = word(entry, 20)?;
+        if flags & !ACE_FLAGS != 0 || permissions & !ACE_PERMISSIONS != 0 {
+            return Err(invalid("unsupported ACL entry flags or rights"));
+        }
+        entries.push(Ace { principal, kind, flags, permissions });
+    }
+    Ok(AclSnapshot::Present { flags, entries })
+}
+
+fn encode_filesec(snapshot: &AclSnapshot, limits: Limits) -> io::Result<Vec<u8>> {
+    let (flags, entries): (u32, &[Ace]) = match snapshot {
+        AclSnapshot::Absent => (0, &[]),
+        AclSnapshot::Present { flags, entries } => (*flags, entries),
+    };
+    if entries.len() > limits.maximum_entries || entries.len() > MAX_ENTRIES || flags & !ACL_FLAGS != 0 {
+        return Err(io::Error::new(io::ErrorKind::InvalidInput, "unsupported ACL flags or entry count"));
+    }
+    let mut bytes = Vec::with_capacity(FILESEC_HEADER + entries.len() * ACE_BYTES);
+    bytes.resize(FILESEC_HEADER, 0);
+    bytes[..4].copy_from_slice(&FILESEC_MAGIC.to_ne_bytes());
+    let count = if matches!(snapshot, AclSnapshot::Absent) { NO_ACL } else { entries.len() as u32 };
+    bytes[36..40].copy_from_slice(&count.to_ne_bytes());
+    bytes[40..44].copy_from_slice(&flags.to_ne_bytes());
+    for entry in entries {
+        if entry.flags & !ACE_FLAGS != 0 || entry.permissions & !ACE_PERMISSIONS != 0 {
+            return Err(io::Error::new(io::ErrorKind::InvalidInput, "unsupported ACL entry flags or rights"));
+        }
+        let kind = match entry.kind { AceKind::Allow => 1, AceKind::Deny => 2 };
+        bytes.extend_from_slice(&entry.principal);
+        bytes.extend_from_slice(&(kind | entry.flags).to_ne_bytes());
+        bytes.extend_from_slice(&entry.permissions.to_ne_bytes());
+    }
+    Ok(bytes)
+}
+
+fn word(bytes: &[u8], offset: usize) -> io::Result<u32> {
+    let value = bytes.get(offset..offset + 4).ok_or_else(|| invalid("short ACL field"))?;
+    Ok(u32::from_ne_bytes([value[0], value[1], value[2], value[3]]))
+}
+
+fn invalid(message: &str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, message)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn entry(kind: AceKind, principal: u8) -> Ace {
+        Ace { principal: [principal; 16], kind, flags: 0x10, permissions: 0x01f0_0002 }
+    }
+
+    fn reply(payload: &[u8]) -> Vec<u8> {
+        let mut bytes = Vec::new();
+        bytes.extend_from_slice(&((12 + payload.len()) as u32).to_ne_bytes());
+        bytes.extend_from_slice(&8_u32.to_ne_bytes());
+        bytes.extend_from_slice(&(payload.len() as u32).to_ne_bytes());
+        bytes.extend_from_slice(payload);
+        bytes
+    }
+
+    #[test]
+    fn absent_and_present_empty_remain_distinct() {
+        let limits = Limits { maximum_entries: 0 };
+        for snapshot in [AclSnapshot::Absent, AclSnapshot::Present { flags: 0, entries: vec![] }] {
+            let bytes = encode_filesec(&snapshot, limits).unwrap();
+            assert_eq!(decode_filesec(&bytes, limits).unwrap(), snapshot);
+        }
+        assert_eq!(decode_security_reply(&reply(&[]), limits).unwrap(), AclSnapshot::Absent);
+        assert_ne!(AclSnapshot::Absent, AclSnapshot::Present { flags: 0, entries: vec![] });
+    }
+
+    #[test]
+    fn snapshot_preserves_uuid_order_duplicates_private_flags_and_generic_rights() {
+        let snapshot = AclSnapshot::Present {
+            flags: 0x0003_2345,
+            entries: vec![entry(AceKind::Deny, 0xa5), entry(AceKind::Allow, 0x19), entry(AceKind::Deny, 0xa5)],
+        };
+        let bytes = encode_filesec(&snapshot, Limits::default()).unwrap();
+        assert_eq!(decode_security_reply(&reply(&bytes), Limits::default()).unwrap(), snapshot);
+    }
+
+    #[test]
+    fn unsupported_bits_are_refused_in_both_directions() {
+        let limits = Limits::default();
+        let mut snapshots = vec![AclSnapshot::Present { flags: 0x0004_0000, entries: vec![] }];
+        let mut bad_flags = entry(AceKind::Allow, 1);
+        bad_flags.flags = 0x200;
+        snapshots.push(AclSnapshot::Present { flags: 0, entries: vec![bad_flags] });
+        let mut bad_rights = entry(AceKind::Allow, 1);
+        bad_rights.permissions = 1;
+        snapshots.push(AclSnapshot::Present { flags: 0, entries: vec![bad_rights] });
+        for snapshot in snapshots {
+            assert!(encode_filesec(&snapshot, limits).is_err());
+        }
+        let valid = AclSnapshot::Present { flags: 0, entries: vec![entry(AceKind::Allow, 1)] };
+        let bytes = encode_filesec(&valid, limits).unwrap();
+        for (offset, value) in [(40, 0x0004_0000_u32), (60, 3), (60, 0x201), (64, 1)] {
+            let mut invalid = bytes.clone();
+            invalid[offset..offset + 4].copy_from_slice(&value.to_ne_bytes());
+            assert!(decode_filesec(&invalid, limits).is_err());
+        }
+    }
+
+    #[test]
+    fn caller_and_native_count_bounds_are_enforced() {
+        assert!(Limits { maximum_entries: 129 }.validate().is_err());
+        let snapshot = AclSnapshot::Present { flags: 0, entries: vec![entry(AceKind::Allow, 1); 128] };
+        let bytes = encode_filesec(&snapshot, Limits::default()).unwrap();
+        assert_eq!(bytes.len(), 44 + 128 * 24);
+        assert!(decode_filesec(&bytes, Limits { maximum_entries: 127 }).is_err());
+        assert!(encode_filesec(&snapshot, Limits { maximum_entries: 127 }).is_err());
+        let oversized = AclSnapshot::Present { flags: 0, entries: vec![entry(AceKind::Allow, 1); 129] };
+        assert!(encode_filesec(&oversized, Limits::default()).is_err());
+    }
+
+    #[test]
+    fn invalid_reply_lengths_offsets_and_ownership_are_not_absence() {
+        let snapshot = AclSnapshot::Present { flags: 0, entries: vec![entry(AceKind::Allow, 1)] };
+        let filesec = encode_filesec(&snapshot, Limits::default()).unwrap();
+        let bytes = reply(&filesec);
+        for length in 0..bytes.len() {
+            assert!(decode_security_reply(&bytes[..length], Limits::default()).is_err());
+        }
+        for (offset, value) in [(0, u32::MAX), (4, u32::MAX), (4, 0), (8, 0)] {
+            let mut invalid = bytes.clone();
+            invalid[offset..offset + 4].copy_from_slice(&value.to_ne_bytes());
+            assert!(decode_security_reply(&invalid, Limits::default()).is_err());
+        }
+        let mut unexpected_owner = filesec;
+        unexpected_owner[4] = 1;
+        assert!(decode_filesec(&unexpected_owner, Limits::default()).is_err());
+    }
+
+    #[test]
+    fn absent_sentinel_requires_exact_header_without_flags() {
+        let bytes = encode_filesec(&AclSnapshot::Absent, Limits::default()).unwrap();
+        let mut flagged = bytes.clone();
+        flagged[40..44].copy_from_slice(&1_u32.to_ne_bytes());
+        assert!(decode_filesec(&flagged, Limits::default()).is_err());
+        let mut extended = bytes;
+        extended.push(0);
+        assert!(decode_filesec(&extended, Limits::default()).is_err());
+    }
+
+    #[test]
+    fn absent_capability_validity_or_support_is_an_error() {
+        let mut bytes = [0_u8; 36];
+        bytes[..4].copy_from_slice(&36_u32.to_ne_bytes());
+        assert!(decode_capability_reply(&bytes).is_err());
+        bytes[8..12].copy_from_slice(&VOL_EXTENDED_SECURITY.to_ne_bytes());
+        assert!(decode_capability_reply(&bytes).is_err());
+        bytes[24..28].copy_from_slice(&VOL_EXTENDED_SECURITY.to_ne_bytes());
+        assert!(decode_capability_reply(&bytes).is_ok());
+        bytes[8..12].copy_from_slice(&0_u32.to_ne_bytes());
+        assert!(decode_capability_reply(&bytes).is_err());
+    }
+}
