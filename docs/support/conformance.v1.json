    "preview-no-write",
    "bundle-generated-allowlist",
    "inspect-unsigned",
    "no-clobber",
    "unknown-input-refusal",
    "tampered-member-refusal",
    "path-traversal-refusal",
    "duplicate-member-refusal",
    "oversize-refusal",
    "alias-refusal",
    "health-unknown-not-zero"
