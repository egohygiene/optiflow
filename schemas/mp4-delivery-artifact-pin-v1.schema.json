{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/optiflow/schemas/mp4-delivery-artifact-pin-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "directory",
    "manifest_digest",
    "candidate_digest",
    "candidate_bytes",
    "evidence_digest"
  ],
  "properties": {
    "directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "manifest_digest": {
      "$ref": "mp4-delivery-request-v1.schema.json#/$defs/digest"
    },
    "candidate_digest": {
      "$ref": "mp4-delivery-request-v1.schema.json#/$defs/digest"
    },
    "candidate_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 268435456
    },
    "evidence_digest": {
      "$ref": "mp4-delivery-request-v1.schema.json#/$defs/digest"
    }
  }
}
