{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/optiflow/schemas/replacement-approval-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authorization_id",
    "plan_fingerprint",
    "approved_by",
    "authority",
    "approved_at"
  ],
  "properties": {
    "schema": {
      "const": "optiflow.replacement-approval.v1"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approved_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "authority": {
      "const": "restorable_png_replacement_only"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
