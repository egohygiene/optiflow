{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/optiflow/schemas/extension-result-v1.schema.json",
  "title": "optiflow extension result v1",
  "type": "object",
  "required": [
    "schema", "invocation_id", "extension", "capability_id", "outcome", "coverage",
    "consumed_artifacts", "evidence", "policy_contributions", "plan_operations", "validations", "reports",
    "diagnostics", "progress", "provenance", "observed_effects", "checkpoint_references"
  ],
  "properties": {
    "schema": { "const": "optiflow.extension-result.v1" },
    "invocation_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "extension": { "$ref": "#/$defs/extension" },
    "capability_id": { "type": "string", "pattern": "^optiflow/[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$", "maxLength": 200 },
    "outcome": { "enum": ["produced", "reused", "unavailable", "cancelled", "failed"] },
    "coverage": {
      "type": "object", "required": ["status", "limitations"],
      "properties": {
        "status": { "enum": ["complete", "partial"] },
        "limitations": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1000 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "consumed_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 }, "uniqueItems": true },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "policy_contributions": { "type": "array", "items": { "$ref": "#/$defs/policy" } },
    "plan_operations": { "type": "array", "items": { "$ref": "#/$defs/planOperation" } },
    "validations": { "type": "array", "items": { "$ref": "#/$defs/validation" } },
    "reports": { "type": "array", "items": { "$ref": "#/$defs/report" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "progress": { "type": "array", "items": { "$ref": "#/$defs/progress" } },
    "provenance": { "$ref": "#/$defs/provenance" },
    "observed_effects": { "$ref": "#/$defs/effects" },
    "checkpoint_references": { "type": "array", "items": { "$ref": "#/$defs/artifact" }, "maxItems": 10000 }
  },
  "additionalProperties": false,
  "$defs": {
    "qualifiedId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$", "maxLength": 200 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "digest": {
      "type": "object", "required": ["algorithm", "value"],
      "properties": { "algorithm": { "const": "blake3-256" }, "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
      "additionalProperties": false
    },
    "extension": {
      "type": "object", "required": ["extension_id", "version", "manifest_digest"],
      "properties": { "extension_id": { "$ref": "#/$defs/qualifiedId" }, "version": { "$ref": "#/$defs/version" }, "manifest_digest": { "$ref": "#/$defs/digest" } },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object", "required": ["artifact_id", "schema", "content_digest"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1, "maxLength": 300 },
        "schema": { "type": "string", "minLength": 1, "maxLength": 200 },
        "content_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "array", "uniqueItems": true,
      "items": { "enum": ["artifact-read", "isolated-workspace-write", "subprocess", "network", "gpu", "source-mutation", "destructive", "sign", "publish"] }
    },
    "evidence": {
      "type": "object", "required": ["evidence_id", "schema", "value", "fingerprint"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1, "maxLength": 300 },
        "schema": { "type": "string", "minLength": 1, "maxLength": 200 },
        "value": true,
        "fingerprint": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "preconditions": {
      "type": "object",
      "required": ["observation_revalidation", "full_hash", "byte_confirmation", "plan_identity", "explicit_authorization", "provenance"],
      "properties": {
        "observation_revalidation": { "const": true },
        "full_hash": { "const": true },
        "byte_confirmation": { "const": true },
        "plan_identity": { "const": true },
        "explicit_authorization": { "const": true },
        "provenance": { "const": true }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object", "required": ["policy_id", "schema", "value", "fingerprint"],
      "properties": {
        "policy_id": { "type": "string", "minLength": 1, "maxLength": 300 },
        "schema": { "type": "string", "minLength": 1, "maxLength": 200 },
        "value": true,
        "fingerprint": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "planOperation": {
      "type": "object",
      "required": ["operation_id", "action_kind", "input_artifacts", "expected_output_schemas", "preconditions", "mutates_source", "requires_core_execution", "fingerprint"],
      "properties": {
        "operation_id": { "type": "string", "minLength": 1, "maxLength": 300 },
        "action_kind": { "type": "string", "minLength": 1, "maxLength": 200 },
        "input_artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
        "expected_output_schemas": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 200 }, "uniqueItems": true },
        "preconditions": { "$ref": "#/$defs/preconditions" },
        "mutates_source": { "const": false },
        "requires_core_execution": { "const": true },
        "fingerprint": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object", "required": ["validator_id", "validator_version", "status", "evidence"],
      "properties": {
        "validator_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "validator_version": { "$ref": "#/$defs/version" },
        "status": { "enum": ["passed", "warning", "failed"] },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "additionalProperties": false
    },
    "report": {
      "type": "object", "required": ["report_id", "schema", "value", "fingerprint"],
      "properties": {
        "report_id": { "type": "string", "minLength": 1, "maxLength": 300 },
        "schema": { "type": "string", "minLength": 1, "maxLength": 200 },
        "value": true,
        "fingerprint": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object", "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 200 },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "progress": {
      "type": "object", "required": ["sequence", "completed", "unit", "message"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "completed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 100 },
        "message": { "type": "string", "maxLength": 1000 }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["extension", "capability_id", "capability_version", "configuration_fingerprint", "input_fingerprints", "authorization_lock_id", "authorization_lock_digest", "grants_digest", "execution_mode"],
      "properties": {
        "extension": { "$ref": "#/$defs/extension" },
        "capability_id": { "type": "string", "pattern": "^optiflow/[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$", "maxLength": 200 },
        "capability_version": { "$ref": "#/$defs/version" },
        "configuration_fingerprint": { "$ref": "#/$defs/digest" },
        "input_fingerprints": { "type": "array", "items": { "$ref": "#/$defs/digest" } },
        "authorization_lock_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "authorization_lock_digest": { "$ref": "#/$defs/digest" },
        "grants_digest": { "$ref": "#/$defs/digest" },
        "execution_mode": { "type": "string", "minLength": 1, "maxLength": 100 }
      },
      "additionalProperties": false
    }
  }
}
