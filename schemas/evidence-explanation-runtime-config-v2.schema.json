{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/optiflow/schemas/evidence-explanation-runtime-config-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "profile",
    "deployment"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "fingerprint",
        "provider_id",
        "model_id",
        "runtime_revision",
        "template",
        "template_fingerprint",
        "output_schema_digest",
        "backend",
        "local_only"
      ],
      "properties": {
        "schema": {
          "const": "optiflow.evidence-explanation-runtime-profile.v1"
        },
        "fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "const": "blake3-256"
            },
            "value": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runtime_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "template_fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "const": "blake3-256"
            },
            "value": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "output_schema_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "const": "blake3-256"
            },
            "value": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "backend": {
          "const": "local_process_sdk_v1"
        },
        "local_only": {
          "const": true
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "runtime_version",
        "model_name",
        "model_sha256",
        "service_egress_disabled_declared",
        "context_tokens",
        "output_tokens"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 9,
          "maxLength": 64
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "model_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "model_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "service_egress_disabled_declared": {
          "const": true
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 512,
          "maximum": 32768
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        }
      }
    }
  }
}
