{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/optiflow/schemas/local-explanation-setup-request-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "enabled",
    "executable",
    "working_directory",
    "deployment",
    "template"
  ],
  "properties": {
    "schema": {
      "const": "optiflow.local-explanation-setup-request.v1"
    },
    "enabled": {
      "type": "boolean"
    },
    "executable": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "working_directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "runtime_version",
        "model_name",
        "model_sha256",
        "service_egress_disabled_declared",
        "context_tokens",
        "output_tokens"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "minLength": 9,
          "maxLength": 64
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "model_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "model_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "service_egress_disabled_declared": {
          "const": true
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 512,
          "maximum": 32768
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        }
      }
    },
    "template": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}
