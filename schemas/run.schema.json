{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/optiflow/schemas/run.schema.json",
  "title": "optiflow run v3",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "completed_at",
    "inputs",
    "options",
    "artifact_directory",
    "discovered_files",
    "analyzed_files",
    "cache_hits",
    "total_bytes",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": "optiflow.run.v3" },
    "run_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "options": {
      "type": "object",
      "required": [
        "follow_symlinks",
        "include_hidden",
        "cross_filesystems",
        "probe_media"
      ],
      "properties": {
        "follow_symlinks": { "type": "boolean" },
        "include_hidden": { "type": "boolean" },
        "cross_filesystems": { "type": "boolean" },
        "probe_media": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "artifact_directory": { "type": "string" },
    "discovered_files": { "type": "integer", "minimum": 0 },
    "analyzed_files": { "type": "integer", "minimum": 0 },
    "cache_hits": { "type": "integer", "minimum": 0 },
    "total_bytes": { "type": "integer", "minimum": 0 },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
