{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/optiflow/schemas/execution-mutation-v2.schema.json",
  "title": "Optiflow bounded quarantine mutation evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "plan_fingerprint",
    "authorization_id",
    "started_at",
    "completed_at",
    "dry_run",
    "status",
    "namespace",
    "attempts",
    "committed_actions",
    "capacity",
    "savings",
    "diagnostics",
    "recovery_guarantee"
  ],
  "properties": {
    "schema": {
      "const": "optiflow.execution-mutation.v2"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "plan_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "dry_run": {
      "const": false
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "rejected",
        "interrupted"
      ]
    },
    "namespace": {
      "$ref": "#/$defs/serialized_path"
    },
    "attempts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "committed_actions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "capacity": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/capacity"
      }
    },
    "savings": {
      "$ref": "#/$defs/savings"
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "recovery_guarantee": {
      "const": "inspect_journal_and_paths_before_manual_restore; no_automatic_resume"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "running"
          }
        }
      },
      "then": {
        "properties": {
          "completed_at": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "completed",
              "rejected",
              "interrupted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "attempts": {
            "minItems": 1,
            "items": {
              "properties": {
                "committed": {
                  "const": true
                }
              }
            }
          },
          "diagnostics": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "serialized_path": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "encoding",
            "value"
          ],
          "properties": {
            "encoding": {
              "const": "utf8"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "encoding",
            "base64"
          ],
          "properties": {
            "encoding": {
              "const": "unix_bytes"
            },
            "base64": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]*={0,2}$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "diagnostic_context": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/serialized_path"
        },
        "run_id": {
          "type": "string"
        },
        "artifact_kind": {
          "type": "string"
        },
        "os_error_kind": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "setting": {
          "type": "string"
        },
        "environment_variable": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "classification",
        "impact",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "invalid_invocation",
            "invalid_command_input",
            "required_capability_unavailable",
            "optional_capability_unavailable",
            "partial_inventory",
            "source_run_partial",
            "source_run_interrupted",
            "stored_run_not_found",
            "stored_state_incompatible",
            "artifact_set_incomplete",
            "artifact_set_incompatible",
            "stale_evidence_prevents_operation",
            "artifact_validation_failed",
            "artifact_commit_failed",
            "state_transaction_failed",
            "internal_invariant_violated",
            "operation_interrupted",
            "operation_terminated",
            "structured_output_failed",
            "output_destination_invalid",
            "result_produced_with_exclusions",
            "configuration_not_found",
            "configuration_unreadable",
            "configuration_not_regular_file",
            "configuration_parse_failed",
            "configuration_schema_missing",
            "configuration_schema_unsupported",
            "configuration_unknown_key",
            "configuration_value_invalid",
            "configuration_value_out_of_range",
            "configuration_conflict",
            "configuration_selector_conflict",
            "configuration_environment_invalid",
            "configuration_path_resolution_failed",
            "configuration_discovery_failed",
            "configuration_source_replaced_during_read",
            "configuration_override_shadowed",
            "configuration_deprecated_key",
            "configuration_locked_invariant",
            "effective_policy_invalid",
            "effective_policy_serialization_failed",
            "effective_policy_fingerprint_mismatch",
            "historical_policy_unknown",
            "source_policy_differs",
            "configuration_setting_unknown",
            "execution_plan_invalid",
            "execution_approval_required",
            "execution_approval_mismatch",
            "execution_bounds_exceeded",
            "execution_scope_invalid",
            "execution_policy_mismatch",
            "execution_source_stale",
            "execution_source_unavailable",
            "execution_ambiguous_identity",
            "execution_read_only",
            "execution_capacity_unavailable",
            "execution_capacity_insufficient",
            "execution_unsupported",
            "execution_destination_occupied"
          ]
        },
        "severity": {
          "enum": [
            "information",
            "warning",
            "error",
            "fatal"
          ]
        },
        "classification": {
          "enum": [
            "input",
            "capability",
            "coverage",
            "observation",
            "state",
            "artifact",
            "interruption",
            "internal"
          ]
        },
        "impact": {
          "enum": [
            "none",
            "degrades_coverage",
            "blocks_command"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "$ref": "#/$defs/diagnostic_context"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystem_id",
        "available_bytes",
        "source_logical_bytes",
        "retained_cross_filesystem_copy_bytes",
        "journal_and_metadata_budget_bytes",
        "projected_peak_additional_bytes",
        "reserve_bytes"
      ],
      "properties": {
        "filesystem_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "available_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "source_logical_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "retained_cross_filesystem_copy_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "journal_and_metadata_budget_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "projected_peak_additional_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "reserve_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    },
    "savings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_logical_bytes",
        "immediate_logical_reclaimed_bytes",
        "physical_reclaimed_bytes",
        "physical_status",
        "reason"
      ],
      "properties": {
        "selected_logical_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "immediate_logical_reclaimed_bytes": {
          "const": 0
        },
        "physical_reclaimed_bytes": {
          "const": null
        },
        "physical_status": {
          "const": "unknown"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "action_id",
        "source",
        "temporary",
        "destination",
        "topology",
        "phase",
        "committed"
      ],
      "properties": {
        "schema": {
          "const": "optiflow.execution-mutation-attempt.v2"
        },
        "action_id": {
          "type": "string",
          "pattern": "^action-[0-9]{6}$"
        },
        "source": {
          "$ref": "#/$defs/serialized_path"
        },
        "temporary": {
          "$ref": "#/$defs/serialized_path"
        },
        "destination": {
          "$ref": "#/$defs/serialized_path"
        },
        "topology": {
          "enum": [
            "same_filesystem",
            "cross_filesystem"
          ]
        },
        "phase": {
          "enum": [
            "prepared",
            "namespace_pending",
            "namespace_durable",
            "preflighted",
            "rename_pending",
            "copy_pending",
            "temp_synced",
            "destination_pending",
            "destination_durable",
            "source_removal_pending",
            "source_removed",
            "committed"
          ]
        },
        "committed": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "committed": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "phase": {
                "const": "committed"
              }
            }
          }
        }
      ]
    }
  }
}
