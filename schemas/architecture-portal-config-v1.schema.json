{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optiflow.egohygiene.io/schemas/architecture-portal-config-v1.schema.json",
  "title": "OptiFlow architecture portal configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "repository",
    "product",
    "categories",
    "runtimeLayers",
    "platformBoundaries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "optiflow.architecture-portal-config.v1"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "product": {
      "$ref": "#/$defs/product"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "runtimeLayers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/runtimeLayer"
      }
    },
    "platformBoundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/platformBoundary"
      }
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "revision",
        "sourceUrl"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "eyebrow",
        "summary",
        "title"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "eyebrow": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "documentIds",
        "id",
        "label",
        "question"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "documentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/documentId"
          }
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtimeLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components",
        "id",
        "label",
        "state",
        "summary"
      ],
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "current",
            "target"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "platformBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eyebrow",
        "id",
        "items",
        "label",
        "summary"
      ],
      "properties": {
        "eyebrow": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "documentId": {
      "type": "string",
      "pattern": "^optiflow-[a-z0-9-]+$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    }
  }
}
