{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/optiflow/schemas/extension-manifest-v1.schema.json",
  "title": "optiflow extension manifest v1",
  "type": "object",
  "required": [
    "schema", "extension_id", "version", "publisher", "sdk_contract",
    "configuration_schemas", "capabilities", "execution_modes",
    "requested_effects", "replacement", "observer_hooks"
  ],
  "properties": {
    "schema": { "const": "optiflow.extension-manifest.v1" },
    "extension_id": { "$ref": "#/$defs/qualifiedId" },
    "version": { "$ref": "#/$defs/version" },
    "publisher": {
      "type": "object",
      "required": ["id", "display_name"],
      "properties": {
        "id": { "$ref": "#/$defs/qualifiedId" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "additionalProperties": false
    },
    "sdk_contract": { "type": "string", "minLength": 1, "maxLength": 100 },
    "configuration_schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_id", "schema_digest", "document"],
        "properties": {
          "schema_id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "schema_digest": { "$ref": "#/$defs/digest" },
          "document": true
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    },
    "execution_modes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/executionMode" }
    },
    "requested_effects": { "$ref": "#/$defs/effects" },
    "replacement": {
      "type": "object",
      "required": ["replaces", "fallbacks_for"],
      "properties": {
        "replaces": { "type": "array", "items": { "$ref": "#/$defs/qualifiedId" }, "uniqueItems": true },
        "fallbacks_for": { "type": "array", "items": { "$ref": "#/$defs/qualifiedId" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "observer_hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hook_id", "lifecycle_points", "read_only"],
        "properties": {
          "hook_id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "lifecycle_points": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "enum": ["discover", "inspect", "plan", "authorize", "execute", "validate", "commit-evidence"] }
          },
          "read_only": { "const": true }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "qualifiedId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$", "maxLength": 200 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "digest": {
      "type": "object", "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "blake3-256" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "effect": {
      "enum": [
        "artifact-read", "isolated-workspace-write", "subprocess", "network", "gpu",
        "source-mutation", "destructive", "sign", "publish"
      ]
    },
    "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" }, "uniqueItems": true },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 }, "uniqueItems": true },
    "capability": {
      "type": "object",
      "required": [
        "capability_id", "capability_version", "kind", "configuration_schema",
        "accepts", "produces", "preconditions", "postconditions", "determinism",
        "cacheability", "coverage", "resource_needs", "locality", "content_changes", "effects"
      ],
      "properties": {
        "capability_id": { "type": "string", "pattern": "^optiflow/[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$", "maxLength": 200 },
        "capability_version": { "$ref": "#/$defs/version" },
        "kind": { "enum": ["inspector", "analyzer", "policy_contributor", "planner", "validator", "report_provider", "lifecycle_observer"] },
        "configuration_schema": { "type": "string", "minLength": 1, "maxLength": 200 },
        "accepts": { "$ref": "#/$defs/stringList" },
        "produces": { "$ref": "#/$defs/stringList" },
        "preconditions": { "$ref": "#/$defs/stringList" },
        "postconditions": { "$ref": "#/$defs/stringList" },
        "determinism": { "enum": ["deterministic", "best_effort", "non_deterministic"] },
        "cacheability": { "enum": ["cacheable", "not_cacheable"] },
        "coverage": {
          "type": "object", "required": ["mode", "dimensions"],
          "properties": {
            "mode": { "enum": ["complete", "partial_by_design"] },
            "dimensions": { "$ref": "#/$defs/stringList" }
          },
          "additionalProperties": false
        },
        "resource_needs": {
          "type": "object", "required": ["cpu_threads", "memory_bytes", "temporary_storage_bytes", "gpu"],
          "properties": {
            "cpu_threads": { "type": "integer", "minimum": 1, "maximum": 1024 },
            "memory_bytes": { "type": "integer", "minimum": 0 },
            "temporary_storage_bytes": { "type": "integer", "minimum": 0 },
            "gpu": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "locality": {
          "type": "object", "required": ["local_only", "network_hosts"],
          "properties": {
            "local_only": { "type": "boolean" },
            "network_hosts": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 253 }, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "content_changes": { "type": "boolean" },
        "effects": { "$ref": "#/$defs/effects" }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object", "required": ["timeout_ms", "max_stdin_bytes", "max_stdout_bytes", "max_stderr_bytes"],
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "max_stdin_bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "max_stdout_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "max_stderr_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      },
      "additionalProperties": false
    },
    "executionMode": {
      "oneOf": [
        {
          "type": "object", "required": ["kind", "name", "entrypoint"],
          "properties": {
            "kind": { "const": "embedded" },
            "name": { "type": "string", "minLength": 1, "maxLength": 100 },
            "entrypoint": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "additionalProperties": false
        },
        {
          "type": "object", "required": ["kind", "name", "protocol", "arguments", "limits"],
          "properties": {
            "kind": { "const": "process" },
            "name": { "type": "string", "minLength": 1, "maxLength": 100 },
            "protocol": { "const": "optiflow.extension-invocation.v1" },
            "arguments": { "type": "array", "items": { "type": "string", "maxLength": 1000 }, "maxItems": 64 },
            "limits": { "$ref": "#/$defs/limits" }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
