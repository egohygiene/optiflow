{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/optiflow/schemas/execution-finalization-status-v4.schema.json",
  "title": "Optiflow irreversible finalization status v4",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "run_id", "status", "actions", "events", "logical_bytes_removed", "observed_allocated_bytes_removed", "shared_extent_bytes", "physical_reclaimed_bytes", "recovery_history"],
  "properties": {
    "schema": {"const": "optiflow.execution-finalization-status.v4"},
    "run_id": {"type": "string", "format": "uuid"},
    "status": {"enum": ["not_started", "partially_finalized", "finalized_irreversible", "attention_required"]},
    "actions": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "object", "additionalProperties": false, "required": ["action_id", "state"], "properties": {"action_id": {"type": "string", "pattern": "^action-[0-9]{6}$"}, "state": {"enum": ["not_selected", "quarantined", "restored", "retained", "finalized_irreversible", "pending_irreversible_inspection", "ambiguous"]}}}},
    "events": {"type": "array", "maxItems": 2000, "items": {"type": "object", "required": ["schema", "event_id", "phase"]}},
    "logical_bytes_removed": {"type": "integer", "minimum": 0},
    "observed_allocated_bytes_removed": {"type": "integer", "minimum": 0},
    "shared_extent_bytes": {"const": null},
    "physical_reclaimed_bytes": {"const": null},
    "recovery_history": {"type": "object", "required": ["schema", "run_id"]}
  }
}
