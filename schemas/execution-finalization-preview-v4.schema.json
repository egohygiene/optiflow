{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/optiflow/schemas/execution-finalization-preview-v4.schema.json",
  "title": "Optiflow irreversible finalization preview v4",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "fingerprint", "body"],
  "properties": {
    "schema": {"const": "optiflow.execution-finalization-preview.v4"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "body": {"type": "object", "additionalProperties": false,
      "required": ["run_id", "plan_fingerprint", "execution_approval_id", "selected_actions", "quarantine_manifest_digest", "entries", "previewed_at", "producer_version", "configuration_fingerprint", "policy_fingerprint", "irreversible_notice"],
      "properties": {
        "run_id": {"type": "string", "format": "uuid"},
        "plan_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "execution_approval_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selected_actions": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "pattern": "^action-[0-9]{6}$"}},
        "quarantine_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "entries": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/entry"}},
        "previewed_at": {"type": "string", "format": "date-time"},
        "producer_version": {"type": "string", "minLength": 1},
        "configuration_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "policy_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "irreversible_notice": {"const": "permanent_quarantine_file_removal; operator_backup_responsibility"}
      }
    }
  },
  "$defs": {
    "identity": {"type": "object", "additionalProperties": false,
      "required": ["platform", "filesystem_id", "file_id", "link_count"],
      "properties": {"platform": {"type": "string"}, "filesystem_id": {"type": "string"}, "file_id": {"type": "string"}, "link_count": {"const": 1}}},
    "entry": {"type": "object", "additionalProperties": false,
      "required": ["action_id", "quarantine_identity", "survivor_identity", "logical_bytes", "observed_allocated_bytes", "blake3", "properties_fingerprint"],
      "properties": {
        "action_id": {"type": "string", "pattern": "^action-[0-9]{6}$"},
        "quarantine_identity": {"$ref": "#/$defs/identity"},
        "survivor_identity": {"$ref": "#/$defs/identity"},
        "logical_bytes": {"type": "integer", "minimum": 0},
        "observed_allocated_bytes": {"type": "integer", "minimum": 0},
        "blake3": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "properties_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
