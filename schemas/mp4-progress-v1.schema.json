{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/optiflow/schemas/mp4-progress-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "operation_id",
    "sequence",
    "phase",
    "transition",
    "entry_index",
    "completed_entries",
    "total_entries",
    "elapsed_ms",
    "authoritative"
  ],
  "properties": {
    "schema": {
      "const": "optiflow.mp4-progress.v1"
    },
    "profile": {
      "const": "optiflow.mp4-h264-aac-delivery.v1"
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "phase": {
      "enum": [
        "operation",
        "planning",
        "runtime_preparation",
        "source_decode",
        "encoding",
        "candidate_validation",
        "artifact_commit",
        "folder_discovery",
        "folder_reconciliation",
        "entry",
        "folder_report"
      ]
    },
    "transition": {
      "enum": [
        "started",
        "finished",
        "stopped",
        "failed"
      ]
    },
    "entry_index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "completed_entries": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "total_entries": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0
    },
    "authoritative": {
      "const": false
    }
  }
}
