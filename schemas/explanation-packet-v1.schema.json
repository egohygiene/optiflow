{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/optiflow/schemas/explanation-packet-v1.schema.json",
  "$comment": "Authored/unvalidated. Exact recorded facts and citation membership are distinct from semantic grounding, source freshness, physical savings and mutation authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packet_fingerprint",
    "sources",
    "facts",
    "omissions",
    "source_freshness",
    "physical_space_reclaimed",
    "mutation_authority"
  ],
  "properties": {
    "schema": {
      "const": "optiflow.explanation-packet.v1"
    },
    "packet_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "blake3-256"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "schema_version",
          "digest",
          "byte_count"
        ],
        "properties": {
          "record_id": {
            "enum": [
              "report",
              "plan"
            ]
          },
          "schema_version": {
            "enum": [
              "optiflow.report.v6",
              "optiflow.plan.v5"
            ]
          },
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm",
              "value"
            ],
            "properties": {
              "algorithm": {
                "const": "blake3-256"
              },
              "value": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "byte_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4194304
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id",
          "record_id",
          "recorded_value"
        ],
        "properties": {
          "fact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "record_id": {
            "enum": [
              "report",
              "plan"
            ]
          },
          "recorded_value": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "omissions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "string"
      }
    },
    "source_freshness": {
      "const": "pinned_report_bytes_only; current_collection_not_observed"
    },
    "physical_space_reclaimed": {
      "const": false
    },
    "mutation_authority": {
      "const": false
    }
  }
}
