{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/optiflow/schemas/video-candidate-evidence-v2.schema.json",
  "title": "Private independently validated stream-copy video candidate evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_set_id",
    "profile",
    "request",
    "request_fingerprint",
    "source",
    "candidate",
    "validation",
    "resources",
    "invocations",
    "encoded_bytes_saved",
    "physical_space_reclaimed",
    "replacement_authority",
    "qualification"
  ],
  "properties": {
    "schema": {
      "const": "optiflow.video-candidate-evidence.v2"
    },
    "artifact_set_id": {
      "type": "string",
      "format": "uuid"
    },
    "profile": {
      "const": "closed_matroska_ffv1_stream_copy_v2"
    },
    "request": {
      "$ref": "#/$defs/request"
    },
    "request_fingerprint": {
      "$ref": "#/$defs/request/$defs/digest"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "snapshot",
        "content",
        "unchanged_at_precommit"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/request/$defs/path"
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "device_id",
            "inode",
            "mode",
            "owner_uid",
            "group_gid",
            "link_count",
            "logical_bytes",
            "modified_unix_ns",
            "changed_unix_ns"
          ],
          "properties": {
            "device_id": {
              "type": "integer",
              "minimum": 0
            },
            "inode": {
              "type": "integer",
              "minimum": 0
            },
            "mode": {
              "type": "integer",
              "minimum": 0
            },
            "owner_uid": {
              "type": "integer",
              "minimum": 0
            },
            "group_gid": {
              "type": "integer",
              "minimum": 0
            },
            "link_count": {
              "type": "integer",
              "minimum": 0
            },
            "logical_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "modified_unix_ns": {
              "type": "integer"
            },
            "changed_unix_ns": {
              "type": "integer"
            }
          }
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "digest",
            "logical_bytes"
          ],
          "properties": {
            "digest": {
              "$ref": "#/$defs/request/$defs/digest"
            },
            "logical_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 134217728
            }
          }
        },
        "unchanged_at_precommit": {
          "const": true
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "digest",
            "logical_bytes"
          ],
          "properties": {
            "digest": {
              "$ref": "#/$defs/request/$defs/digest"
            },
            "logical_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 134217728
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_container",
        "candidate_container",
        "source_decoded_digest",
        "candidate_decoded_digest",
        "decoded_bytes",
        "elementary_packets_and_exact_timing_preserved",
        "complete_decoded_yuv420_samples_equal",
        "strictly_smaller"
      ],
      "properties": {
        "source_container": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "width",
            "height",
            "track_contract",
            "codec_private_digest",
            "packets",
            "technical_tag_count",
            "void_bytes"
          ],
          "properties": {
            "profile": {
              "const": "optiflow.matroska-ffv1-closed-ebml.v2"
            },
            "width": {
              "type": "integer",
              "minimum": 2,
              "maximum": 1280,
              "multipleOf": 2
            },
            "height": {
              "type": "integer",
              "minimum": 2,
              "maximum": 720,
              "multipleOf": 2
            },
            "track_contract": {
              "type": "object",
              "maxProperties": 32,
              "propertyNames": {
                "maxLength": 64
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 1024
              }
            },
            "codec_private_digest": {
              "$ref": "#/$defs/request/$defs/digest"
            },
            "packets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pts_milliseconds",
                  "keyframe",
                  "bytes",
                  "digest"
                ],
                "properties": {
                  "pts_milliseconds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 120000
                  },
                  "keyframe": {
                    "type": "boolean"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 134217728
                  },
                  "digest": {
                    "$ref": "#/$defs/request/$defs/digest"
                  }
                }
              }
            },
            "technical_tag_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "void_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 134217728
            }
          }
        },
        "candidate_container": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "width",
            "height",
            "track_contract",
            "codec_private_digest",
            "packets",
            "technical_tag_count",
            "void_bytes"
          ],
          "properties": {
            "profile": {
              "const": "optiflow.matroska-ffv1-closed-ebml.v2"
            },
            "width": {
              "type": "integer",
              "minimum": 2,
              "maximum": 1280,
              "multipleOf": 2
            },
            "height": {
              "type": "integer",
              "minimum": 2,
              "maximum": 720,
              "multipleOf": 2
            },
            "track_contract": {
              "type": "object",
              "maxProperties": 32,
              "propertyNames": {
                "maxLength": 64
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 1024
              }
            },
            "codec_private_digest": {
              "$ref": "#/$defs/request/$defs/digest"
            },
            "packets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pts_milliseconds",
                  "keyframe",
                  "bytes",
                  "digest"
                ],
                "properties": {
                  "pts_milliseconds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 120000
                  },
                  "keyframe": {
                    "type": "boolean"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 134217728
                  },
                  "digest": {
                    "$ref": "#/$defs/request/$defs/digest"
                  }
                }
              }
            },
            "technical_tag_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "void_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 134217728
            }
          }
        },
        "source_decoded_digest": {
          "$ref": "#/$defs/request/$defs/digest"
        },
        "candidate_decoded_digest": {
          "$ref": "#/$defs/request/$defs/digest"
        },
        "decoded_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "elementary_packets_and_exact_timing_preserved": {
          "const": true
        },
        "complete_decoded_yuv420_samples_equal": {
          "const": true
        },
        "strictly_smaller": {
          "const": true
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_policy",
        "kernel_observations",
        "host_media_buffer_ceiling_bytes",
        "memory_scope",
        "elapsed_scope",
        "free_space_scope"
      ],
      "properties": {
        "selected_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "systemd_run",
            "systemctl",
            "helper",
            "user_bus",
            "provider_subtree_memory_bytes",
            "provider_scratch_bytes",
            "minimum_free_bytes"
          ],
          "properties": {
            "schema": {
              "const": "optiflow.linux-video-sandbox.v1"
            },
            "systemd_run": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "digest"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/",
                  "maxLength": 4096
                },
                "digest": {
                  "$ref": "#/$defs/request/$defs/digest"
                }
              }
            },
            "systemctl": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "digest"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/",
                  "maxLength": 4096
                },
                "digest": {
                  "$ref": "#/$defs/request/$defs/digest"
                }
              }
            },
            "helper": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "digest"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/",
                  "maxLength": 4096
                },
                "digest": {
                  "$ref": "#/$defs/request/$defs/digest"
                }
              }
            },
            "user_bus": {
              "type": "string",
              "pattern": "^/run/user/[0-9]+/bus$"
            },
            "provider_subtree_memory_bytes": {
              "type": "integer",
              "minimum": 67108864,
              "maximum": 2147483648
            },
            "provider_scratch_bytes": {
              "type": "integer",
              "minimum": 1048576,
              "maximum": 134217728,
              "multipleOf": 4096
            },
            "minimum_free_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "kernel_observations": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "memory_max",
              "memory_swap_max",
              "pids_max",
              "scratch_capacity_bytes",
              "writable_filesystems_confined_to_tmp",
              "no_new_privileges",
              "seccomp_filter_active",
              "capabilities_empty"
            ],
            "properties": {
              "schema": {
                "const": "optiflow.video-resource-observation.v1"
              },
              "memory_max": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483648
              },
              "memory_swap_max": {
                "const": 0
              },
              "pids_max": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "scratch_capacity_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 134217728
              },
              "writable_filesystems_confined_to_tmp": {
                "const": true
              },
              "no_new_privileges": {
                "const": true
              },
              "seccomp_filter_active": {
                "const": true
              },
              "capabilities_empty": {
                "const": true
              }
            }
          }
        },
        "host_media_buffer_ceiling_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "memory_scope": {
          "const": "kernel provider subtree quota plus host payload-buffer admission; total host RSS not kernel limited"
        },
        "elapsed_scope": {
          "const": "shared cooperative deadline plus separate at-most-2s cleanup per invocation; host syscalls/parsing not preemptible"
        },
        "free_space_scope": {
          "const": "observed before and at publication; not a filesystem reservation"
        }
      }
    },
    "invocations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_guard",
          "provider",
          "build_fingerprint",
          "argv",
          "input_digest",
          "input_bytes",
          "stdout_digest",
          "captured_stdout_bytes",
          "captured_stderr_bytes",
          "elapsed_ms",
          "child_elapsed_limit_ms",
          "operation_elapsed_limit_ms",
          "operation_elapsed_ms",
          "stdout_limit_bytes",
          "stderr_limit_bytes",
          "child_elapsed_limit_ns",
          "capture_capabilities"
        ],
        "properties": {
          "resource_guard": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "memory_max",
              "memory_swap_max",
              "pids_max",
              "scratch_capacity_bytes",
              "writable_filesystems_confined_to_tmp",
              "no_new_privileges",
              "seccomp_filter_active",
              "capabilities_empty"
            ],
            "properties": {
              "schema": {
                "const": "optiflow.video-resource-observation.v1"
              },
              "memory_max": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483648
              },
              "memory_swap_max": {
                "const": 0
              },
              "pids_max": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "scratch_capacity_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 134217728
              },
              "writable_filesystems_confined_to_tmp": {
                "const": true
              },
              "no_new_privileges": {
                "const": true
              },
              "seccomp_filter_active": {
                "const": true
              },
              "capabilities_empty": {
                "const": true
              }
            }
          },
          "provider": {
            "$ref": "#/$defs/request/$defs/provider"
          },
          "build_fingerprint": {
            "$ref": "#/$defs/request/$defs/digest"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "input_digest": {
            "$ref": "#/$defs/request/$defs/digest"
          },
          "input_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 134217728
          },
          "stdout_digest": {
            "$ref": "#/$defs/request/$defs/digest"
          },
          "captured_stdout_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 536870912
          },
          "captured_stderr_bytes": {
            "const": 0
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          },
          "child_elapsed_limit_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          },
          "operation_elapsed_limit_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          },
          "operation_elapsed_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          },
          "stdout_limit_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 536870912
          },
          "stderr_limit_bytes": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 262144
          },
          "child_elapsed_limit_ns": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000000000
          },
          "capture_capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "retained_stdout_and_stderr_bounded",
              "direct_child_elapsed_bounded",
              "output_cap_terminates_child_immediately",
              "output_cap_aborts_capture_on_detection",
              "stdin_requires_full_copy",
              "process_group_cleanup_before_reap",
              "shared_operation_deadline_checked",
              "host_file_io_preemptible",
              "provider_memory_enforced",
              "provider_scratch_enforced",
              "process_tree_contained",
              "source_or_candidate_validation"
            ],
            "properties": {
              "retained_stdout_and_stderr_bounded": {
                "const": true
              },
              "direct_child_elapsed_bounded": {
                "const": true
              },
              "output_cap_terminates_child_immediately": {
                "const": false
              },
              "output_cap_aborts_capture_on_detection": {
                "const": true
              },
              "stdin_requires_full_copy": {
                "const": false
              },
              "process_group_cleanup_before_reap": {
                "const": true
              },
              "shared_operation_deadline_checked": {
                "const": true
              },
              "host_file_io_preemptible": {
                "const": false
              },
              "provider_memory_enforced": {
                "const": true
              },
              "provider_scratch_enforced": {
                "const": true
              },
              "process_tree_contained": {
                "const": false
              },
              "source_or_candidate_validation": {
                "const": false
              }
            }
          }
        }
      }
    },
    "encoded_bytes_saved": {
      "type": "integer",
      "minimum": 1,
      "maximum": 134217728
    },
    "physical_space_reclaimed": {
      "const": false
    },
    "replacement_authority": {
      "const": false
    },
    "qualification": {
      "const": "source_only_native_host_unqualified"
    }
  },
  "$defs": {
    "request": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://github.com/egohygiene/optiflow/schemas/video-candidate-request-v2.schema.json",
      "title": "Explicit broader bounded FFV1 stream-copy candidate request v2",
      "description": "Pure review preparation. Supplied identities, media facts and limits are not runtime observations, enforced bounds, accepted media or execution authority.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profile",
        "source",
        "operation",
        "policy",
        "producer",
        "producer_build_fingerprint",
        "probe",
        "probe_build_fingerprint",
        "limits"
      ],
      "properties": {
        "schema": {
          "const": "optiflow.video-candidate-request.v2"
        },
        "profile": {
          "const": "optiflow.matroska-ffv1-sdr-candidate.v2"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "policy": {
          "$ref": "#/$defs/policy"
        },
        "producer": {
          "$ref": "#/$defs/provider"
        },
        "producer_build_fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "probe": {
          "$ref": "#/$defs/provider"
        },
        "probe_build_fingerprint": {
          "$ref": "#/$defs/digest"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      },
      "$defs": {
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "const": "blake3-256"
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "path": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "value"
              ],
              "properties": {
                "encoding": {
                  "const": "utf8"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "encoding",
                "base64"
              ],
              "properties": {
                "encoding": {
                  "const": "unix_bytes"
                },
                "base64": {
                  "type": "string",
                  "minLength": 4,
                  "maxLength": 5464,
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                }
              }
            }
          ]
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "executable",
            "binary_digest",
            "invocation_fingerprint"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "executable": {
              "$ref": "#/$defs/path"
            },
            "binary_digest": {
              "$ref": "#/$defs/digest"
            },
            "invocation_fingerprint": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "rational": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "denominator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observation_id",
            "observation_fingerprint",
            "content_digest",
            "logical_bytes",
            "probe_observation_fingerprint",
            "media"
          ],
          "properties": {
            "observation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "observation_fingerprint": {
              "$ref": "#/$defs/digest"
            },
            "content_digest": {
              "$ref": "#/$defs/digest"
            },
            "logical_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 134217728
            },
            "probe_observation_fingerprint": {
              "$ref": "#/$defs/digest"
            },
            "media": {
              "$ref": "#/$defs/media"
            }
          }
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "container",
            "codec",
            "stream_index",
            "total_streams",
            "disposition",
            "width",
            "height",
            "pixel_format",
            "field_order",
            "color_range",
            "color_space",
            "color_transfer",
            "color_primaries",
            "sample_aspect_ratio",
            "frame_rate",
            "time_base",
            "frame_count",
            "start_pts",
            "duration_ticks",
            "constant_frame_rate",
            "rotation_degrees",
