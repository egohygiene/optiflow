{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/optiflow/schemas/video-candidate-request-v1.schema.json",
  "title": "Declared video candidate preparation request",
  "description": "Pure review preparation. Supplied identities, media facts and limits are not runtime observations, enforced bounds, accepted media or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "source", "operation", "policy", "producer", "producer_build_fingerprint", "probe", "probe_build_fingerprint", "limits"],
  "properties": {
    "schema": {"const": "optiflow.video-candidate-request.v1"},
    "profile": {"const": "optiflow.matroska-ffv1-sdr-candidate.v1"},
    "source": {"$ref": "#/$defs/source"},
    "operation": {"$ref": "#/$defs/operation"},
    "policy": {"$ref": "#/$defs/policy"},
    "producer": {"$ref": "#/$defs/provider"},
    "producer_build_fingerprint": {"$ref": "#/$defs/digest"},
    "probe": {"$ref": "#/$defs/provider"},
    "probe_build_fingerprint": {"$ref": "#/$defs/digest"},
    "limits": {"$ref": "#/$defs/limits"}
  },
  "$defs": {
    "digest": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "blake3-256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "path": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["encoding", "value"],
          "properties": {
            "encoding": {"const": "utf8"},
            "value": {"type": "string", "minLength": 1, "maxLength": 4096}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["encoding", "base64"],
          "properties": {
            "encoding": {"const": "unix_bytes"},
            "base64": {"type": "string", "minLength": 4, "maxLength": 5464, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
          }
        }
      ]
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "executable", "binary_digest", "invocation_fingerprint"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "executable": {"$ref": "#/$defs/path"},
        "binary_digest": {"$ref": "#/$defs/digest"},
        "invocation_fingerprint": {"$ref": "#/$defs/digest"}
      }
    },
    "rational": {
      "type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "denominator": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "observation_fingerprint", "content_digest", "logical_bytes", "probe_observation_fingerprint", "media"],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "observation_fingerprint": {"$ref": "#/$defs/digest"},
        "content_digest": {"$ref": "#/$defs/digest"},
        "logical_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "probe_observation_fingerprint": {"$ref": "#/$defs/digest"},
        "media": {"$ref": "#/$defs/media"}
      }
    },
    "media": {
      "type": "object", "additionalProperties": false,
      "required": ["container", "codec", "stream_index", "total_streams", "disposition", "width", "height", "pixel_format", "field_order", "color_range", "color_space", "color_transfer", "color_primaries", "sample_aspect_ratio", "frame_rate", "time_base", "frame_count", "start_pts", "duration_ticks", "constant_frame_rate", "rotation_degrees", "feature_observation_complete", "chapters", "side_data_entries", "descriptive_metadata_entries", "unknown_metadata_entries"],
      "properties": {
        "container": {"type": "string", "minLength": 1, "maxLength": 64},
        "codec": {"type": "string", "minLength": 1, "maxLength": 64},
        "stream_index": {"type": "integer", "minimum": 0, "maximum": 1024},
        "total_streams": {"type": "integer", "minimum": 1, "maximum": 1024},
        "disposition": {"type": "string", "minLength": 1, "maxLength": 64},
        "width": {"type": "integer", "minimum": 2, "maximum": 640},
        "height": {"type": "integer", "minimum": 2, "maximum": 360},
        "pixel_format": {"type": "string", "minLength": 1, "maxLength": 64},
        "field_order": {"type": "string", "minLength": 1, "maxLength": 64},
        "color_range": {"type": "string", "minLength": 1, "maxLength": 64},
        "color_space": {"type": "string", "minLength": 1, "maxLength": 64},
        "color_transfer": {"type": "string", "minLength": 1, "maxLength": 64},
        "color_primaries": {"type": "string", "minLength": 1, "maxLength": 64},
        "sample_aspect_ratio": {"$ref": "#/$defs/rational"},
        "frame_rate": {"$ref": "#/$defs/rational"},
        "time_base": {"$ref": "#/$defs/rational"},
        "frame_count": {"type": "integer", "minimum": 1, "maximum": 250},
        "start_pts": {"type": "integer", "minimum": -1000000, "maximum": 1000000},
        "duration_ticks": {"type": "integer", "minimum": 1, "maximum": 10000},
        "constant_frame_rate": {"type": "boolean"},
        "rotation_degrees": {"type": "integer", "minimum": -360, "maximum": 360},
        "feature_observation_complete": {"type": "boolean"},
        "chapters": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "side_data_entries": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "descriptive_metadata_entries": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "unknown_metadata_entries": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "stream_copy"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "crf", "preset"],
          "properties": {
            "kind": {"const": "h264_lossy"},
            "crf": {"type": "integer", "minimum": 1, "maximum": 51},
            "preset": {"enum": ["fast", "medium", "slow"]}
          }
        }
      ]
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["effective_policy_fingerprint", "source_preserving", "metadata", "require_strictly_smaller"],
      "properties": {
        "effective_policy_fingerprint": {"$ref": "#/$defs/digest"},
        "source_preserving": {"const": true},
        "metadata": {"const": "regenerate_encoder_duration_only"},
        "require_strictly_smaller": {"const": true}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["input_bytes", "candidate_bytes", "decoded_bytes", "temporary_bytes", "memory_bytes", "elapsed_ms"],
      "properties": {
        "input_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "candidate_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "decoded_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864, "description": "Requested cumulative decoded sample bytes per video, independently applied to source and candidate later; excludes allocator/provider overhead."},
        "temporary_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "memory_bytes": {"type": "integer", "minimum": 1, "maximum": 268435456},
        "elapsed_ms": {"type": "integer", "minimum": 1, "maximum": 30000}
      }
    }
  }
}
