{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/egohygiene/optiflow/schemas/execution-finalization-authorization-v4.schema.json",
  "title": "Optiflow separately reviewed irreversible authorization v4",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "authorization_id", "body"],
  "properties": {
    "schema": {"const": "optiflow.execution-finalization-authorization.v4"},
    "authorization_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "body": {"type": "object", "additionalProperties": false,
      "required": ["authority", "preview_fingerprint", "plan_fingerprint", "execution_run_id", "quarantine_manifest_digest", "selected_actions", "approved_by", "approved_at"],
      "properties": {
        "authority": {"const": "irreversible_retained_quarantine_finalization"},
        "preview_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "plan_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "execution_run_id": {"type": "string", "format": "uuid"},
        "quarantine_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selected_actions": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "pattern": "^action-[0-9]{6}$"}},
        "approved_by": {"type": "string", "minLength": 1, "maxLength": 256},
        "approved_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
